extends SceneTree
const Battle = preload("res://scripts/battle_model.gd")
var checks := 0
var failures := 0

func expect(condition: bool, description: String) -> void:
	checks += 1
	if not condition:
		failures += 1
		push_error("FAIL: " + description)

func arena() -> RefCounted:
	var game := Battle.new()
	game.terrain.clear()
	return game

func _initialize() -> void:
	var game := Battle.new()
	game.reset()
	expect(game.units.size() == 12, "Four allies and eight enemies")
	var knight: Dictionary = game.unit_by_id(1)
	expect(knight.kind == "knight" and knight.name == "Knight 2" and knight.hp == 10 and knight.attack == 3 and knight.move == 3 and knight.defense == 1, "Hero 2 becomes Knight with agreed stats")
	expect(knight.cell == Vector2i(2, 5) and game.unit_by_id(3).cell == Vector2i(1, 5), "Heroes start in middle left with Ranger behind Knight")
	expect(Vector2i(3, 5) in game.destinations(knight) and not Vector2i(3, 8) in game.destinations(knight), "Knight movement ends at three steps")
	expect(game.units.all(func(unit): return unit.defense == (1 if unit.id == knight.id else 0)), "Only Knight has Defense 1; all others have zero")
	expect(game.units.filter(func(unit): return unit.team == "enemy").all(func(unit): return unit.attack == 2), "Both enemy types have Attack 2")
	expect(game.unit_by_id(3).range == 3, "Player ranger range")
	expect(game.unit_by_id(11).move == 1 and game.unit_by_id(11).range == 2, "Slinger stats")
	game.activate(0)
	expect(not game.activate(1), "Activation locks selection")
	expect(game.cancel_activation() and game.activate(1), "Untouched activation cancels without penalty")
	expect(game.move_active(Vector2i(3, 5)), "Legal movement")
	expect(not game.cancel_activation() and not game.activate(0), "Movement commits activation")
	expect(not game.move_active(Vector2i(4, 5)), "Only one move per activation")
	game.finish_activation()
	expect(not game.activate(1), "Cannot reactivate a finished unit")
	game.activate(0)
	game.finish_activation()
	expect(not game.unit_by_id(0).finished and game.active_id == -1, "Finishing untouched unit deactivates without spending actions")
	expect(game.activate(0), "Untouched unit remains available after deactivation")
	game = arena()
	var ally: Dictionary = game.add_unit("player", Vector2i(1, 1), "guard")
	game.add_unit("player", Vector2i(2, 1), "guard")
	var foe: Dictionary = game.add_unit("enemy", Vector2i(1, 2), "raider")
	expect(Vector2i(3, 1) in game.destinations(ally), "Can path through ally")
	expect(not Vector2i(2, 1) in game.destinations(ally), "Cannot end on ally")
	expect(not Vector2i(1, 2) in game.paths(ally), "Cannot path through enemy")
	expect(Vector2i(5, 1) in game.destinations(ally) and not Vector2i(6, 1) in game.destinations(ally), "Move 4 boundary")
	game.terrain[Vector2i(3, 1)] = 1
	expect(not Vector2i(5, 1) in game.destinations(ally), "Detour costs movement")
	game.activate(ally.id)
	expect(game.attack_active(foe.id) and foe.hp == 2, "Guaranteed attack deals 3 damage")
	expect(not game.attack_active(foe.id), "Only one attack per activation")
	expect(not game.cancel_activation(), "Attack commits activation")
	expect(game.move_active(Vector2i(0, 1)) and game.active_id == ally.id and not ally.finished, "Attack then move awaits explicit finish")
	game.begin_enemy_turn()
	game.begin_player_turn()
	expect(not ally.finished and not ally.moved and not ally.attacked, "New player turn resets actions")
	game = arena()
	ally = game.add_unit("player", Vector2i(2, 2), "ranger")
	foe = game.add_unit("enemy", Vector2i(4, 2), "slinger")
	game.terrain[Vector2i(3, 2)] = 1
	expect(game.can_hit(ally, foe, ally.cell), "Low cover permits shots")
	game.terrain[Vector2i(3, 2)] = 2
	expect(not game.can_hit(ally, foe, ally.cell), "Wall blocks shots")
	game.terrain.clear()
	foe.cell = Vector2i(4, 4)
	expect(not game.can_hit(ally, foe, ally.cell), "Attack range is Manhattan")
	foe.cell = Vector2i(3, 3)
	game.terrain[Vector2i(3, 2)] = 2
	expect(game.can_hit(ally, foe, ally.cell), "Shot can graze an exposed wall corner")
	game.terrain[Vector2i(2, 3)] = 2
	expect(not game.can_hit(ally, foe, ally.cell), "Two walls meeting diagonally still block shots")
	game.terrain.clear()
	game.terrain[Vector2i(3, 3)] = 2
	foe.cell = Vector2i(4, 3)
	expect(not game.can_hit(ally, foe, ally.cell), "Ray crossing wall interior remains blocked")
	# Exercise each exposed corner through both teams' targeting and real damage.
	for index in range(4):
		game = arena()
		var wall := Vector2i(5, 5)
		ally = game.add_unit("player", wall + game.DIRECTIONS[index], "ranger")
		foe = game.add_unit("enemy", wall + game.DIRECTIONS[(index + 1) % 4], "slinger")
		game.terrain[wall] = 2
		game.activate(ally.id)
		expect(game.can_hit(foe, ally, foe.cell) and ally.cell in game.attack_cells(foe, foe.cell) and foe.cell in game.attack_cells(ally, ally.cell) and game.attack_active(foe.id) and foe.hp == 2, "Both teams can target around exposed corner %d; player hit deals damage" % index)
	game = arena()
	ally = game.add_unit("player", Vector2i(1, 1), "guard")
	foe = game.add_unit("enemy", Vector2i(2, 1), "raider")
	game.begin_enemy_turn()
	expect(game.enemy_action(foe.id) and ally.hp == 8 and foe.cell == Vector2i(2, 1), "Adjacent enemy attacks without moving")
	expect(not game.enemy_action(foe.id) and ally.hp == 8, "Enemy cannot act twice")
	game = arena()
	ally = game.add_unit("player", Vector2i(1, 1), "guard")
	foe = game.add_unit("enemy", Vector2i(4, 1), "raider")
	game.begin_enemy_turn()
	expect(game.enemy_action(foe.id) and ally.hp == 8 and game.distance(foe.cell, Vector2i(4, 1)) == 2, "Raider moves up to 2 then attacks")
	game = arena()
	ally = game.add_unit("player", Vector2i(1, 1), "guard")
	foe = game.add_unit("enemy", Vector2i(4, 1), "slinger")
	game.begin_enemy_turn()
	expect(game.enemy_action(foe.id) and foe.cell == Vector2i(3, 1) and ally.hp == 8, "Slinger moves 1 and attacks at range 2")
	game = arena()
	ally = game.add_unit("player", Vector2i(1, 1), "guard")
	foe = game.add_unit("enemy", Vector2i(2, 1), "raider")
	foe.hp = 2
	game.activate(ally.id)
	game.attack_active(foe.id)
	expect(foe.hp == 0 and game.at(Vector2i(2, 1)).is_empty() and game.outcome == "Victory", "Lethal damage removes enemy occupancy and wins")
	expect(not game.begin_enemy_turn(), "No turn transitions after victory")
	game = arena()
	ally = game.add_unit("player", Vector2i(1, 1), "guard")
	foe = game.add_unit("enemy", Vector2i(2, 1), "raider")
	ally.hp = 1
	game.begin_enemy_turn()
	game.enemy_action(foe.id)
	expect(game.outcome == "Defeat" and ally.hp == 0, "Last ally death loses")
	game = arena()
	foe = game.add_unit("enemy", Vector2i(5, 5), "slinger")
	expect(Vector2i(5, 3) in game.attack_cells(foe, foe.cell), "Slinger immediate range includes distance 2")
	expect(not Vector2i(5, 2) in game.attack_cells(foe, foe.cell), "Immediate range excludes move-only extension")
	expect(Vector2i(5, 2) in game.threat_cells(foe), "Threat includes move 1 plus range 2")
	expect(not Vector2i(5, 1) in game.threat_cells(foe), "Threat excludes squares beyond move plus range")
	for x in range(game.width):
		game.terrain[Vector2i(x, 4)] = 2
	expect(not Vector2i(5, 3) in game.threat_cells(foe), "Threat respects wall line of sight and path blocking")
	for x in range(game.width):
		game.terrain[Vector2i(x, 4)] = 1
	expect(Vector2i(5, 3) in game.threat_cells(foe), "Threat can cross low cover with a shot")
	expect(not Vector2i(5, 2) in game.threat_cells(foe), "Low cover does not grant an illegal move origin")
	game.terrain.clear()
	game.add_unit("enemy", Vector2i(5, 4), "raider")
	expect(not Vector2i(5, 2) in game.threat_cells(foe), "Threat excludes attack from an occupied move destination")
	foe.cell = Vector2i.ZERO
	expect(game.threat_cells(foe).all(func(cell): return game.inside(cell)), "All threat cells stay inside board bounds")
	game = arena()
	ally = game.add_unit("player", Vector2i(1, 5), "guard")
	foe = game.add_unit("enemy", Vector2i(7, 5), "raider")
	expect(foe.perception == 6 and game.visible_heroes(foe).size() == 1, "Raider sees hero at inclusive Perception 6 boundary")
	game.begin_enemy_turn()
	expect(game.enemy_action(foe.id) and foe.cell == Vector2i(5, 5) and ally.hp == 10 and not foe.attacked, "Raider approaches visible hero with Move 2 before it can attack")
	game.begin_player_turn()
	ally.cell = Vector2i(15, 11)
	game.begin_enemy_turn()
	expect(not game.enemy_action(foe.id) and foe.cell == Vector2i(5, 5), "Unguarded enemy stops pursuing after losing sight")
	game = arena()
	ally = game.add_unit("player", Vector2i(1, 5), "guard")
	foe = game.add_unit("enemy", Vector2i(9, 5), "slinger")
	expect(foe.perception == 8 and game.visible_heroes(foe).size() == 1, "Slinger sees hero at inclusive Perception 8 boundary")
	game.begin_enemy_turn()
	expect(game.enemy_action(foe.id) and foe.cell == Vector2i(8, 5) and ally.hp == 10, "Slinger approaches distant hero with Move 1")
	for kind in ["raider", "slinger"]:
		game = arena()
		ally = game.add_unit("player", Vector2i(1, 5), "guard")
		foe = game.add_unit("enemy", Vector2i(8 if kind == "raider" else 10, 5), kind)
		var start: Vector2i = foe.cell
		game.begin_enemy_turn()
		expect(game.visible_heroes(foe).is_empty() and not game.enemy_action(foe.id) and foe.cell == start, "Enemy beyond Perception does not pursue: " + kind)
	game = arena()
	ally = game.add_unit("player", Vector2i(1, 5), "guard")
	foe = game.add_unit("enemy", Vector2i(7, 5), "raider")
	game.terrain[Vector2i(5, 5)] = 2
	game.begin_enemy_turn()
	expect(game.visible_heroes(foe).is_empty() and not game.enemy_action(foe.id), "Wall blocks perception and prevents unseen pursuit")
	game.begin_player_turn()
	game.terrain[Vector2i(5, 5)] = 1
	game.begin_enemy_turn()
	expect(game.visible_heroes(foe).size() == 1 and game.enemy_action(foe.id) and not game.terrain.has(foe.cell), "Low cover allows sight but approach paths go around it")
	ally.hp = 0
	expect(game.visible_heroes(foe).is_empty(), "Defeated heroes cannot be detected")
	for kind in ["ranger", "slinger"]:
		game = arena()
		var shooter: Dictionary = game.add_unit("player" if kind == "ranger" else "enemy", Vector2i(5, 5), kind)
		var victim: Dictionary = game.add_unit("enemy" if kind == "ranger" else "player", Vector2i(6, 5), "raider" if kind == "ranger" else "guard")
		expect(not game.can_hit(shooter, victim, shooter.cell), "Ranged unit cannot attack adjacent target: " + kind)
		expect(not Vector2i(6, 5) in game.attack_cells(shooter, shooter.cell), "Adjacent square excluded from ranged highlights: " + kind)
		victim.cell = Vector2i(7, 5)
		expect(game.can_hit(shooter, victim, shooter.cell), "Ranged unit can attack at distance 2: " + kind)
	game = arena()
	var ranger: Dictionary = game.add_unit("player", Vector2i(5, 5), "ranger")
	foe = game.add_unit("enemy", Vector2i(6, 5), "raider")
	game.activate(ranger.id)
	expect(not game.attack_active(foe.id) and not ranger.attacked and foe.hp == 5, "Rejected adjacent ranged attack spends no action or HP")
	game = arena()
	var strong: Dictionary = game.add_unit("player", Vector2i(4, 5), "guard")
	var weak: Dictionary = game.add_unit("player", Vector2i(8, 5), "guard")
	foe = game.add_unit("enemy", Vector2i(5, 5), "raider")
	weak.hp = 2
	game.begin_enemy_turn()
	game.enemy_action(foe.id)
	expect(weak.hp == 0 and strong.hp == 10 and foe.cell == Vector2i(7, 5), "Enemy moves to weaker reachable hero instead of attacking adjacent healthy hero")
	game = arena()
	strong = game.add_unit("player", Vector2i(4, 5), "guard")
	weak = game.add_unit("player", Vector2i(9, 5), "guard")
	foe = game.add_unit("enemy", Vector2i(5, 5), "raider")
	weak.hp = 1
	game.begin_enemy_turn()
	game.enemy_action(foe.id)
	expect(strong.hp == 8 and weak.hp == 1, "Enemy attacks reachable hero instead of chasing weaker hero outside this-turn reach")
	game = arena()
	strong = game.add_unit("player", Vector2i(4, 5), "guard")
	weak = game.add_unit("player", Vector2i(8, 5), "guard")
	foe = game.add_unit("enemy", Vector2i(5, 5), "raider")
	game.begin_enemy_turn()
	game.enemy_action(foe.id)
	expect(strong.hp == 8 and weak.hp == 10 and foe.cell == Vector2i(5, 5), "Equal-HP targets prefer shortest required move")
	game = arena()
	ally = game.add_unit("player", Vector2i(5, 5), "guard")
	foe = game.add_unit("enemy", Vector2i(6, 5), "slinger")
	game.begin_enemy_turn()
	game.enemy_action(foe.id)
	expect(ally.hp == 8 and game.distance(foe.cell, ally.cell) == 2, "Adjacent slinger moves away before attacking")
	game = arena()
	ally = game.add_unit("player", Vector2i(5, 5), "guard")
	foe = game.add_unit("enemy", Vector2i(6, 5), "slinger")
	for cell in [Vector2i(6, 4), Vector2i(7, 5), Vector2i(6, 6)]: game.terrain[cell] = 2
	game.begin_enemy_turn()
	expect(not game.enemy_action(foe.id) and ally.hp == 10, "Trapped adjacent slinger cannot make an illegal close attack")
	for kind in ["raider", "slinger"]:
		game = arena()
		knight = game.add_unit("player", Vector2i(5, 5), "knight")
		foe = game.add_unit("enemy", Vector2i(6 if kind == "raider" else 7, 5), kind)
		game.begin_enemy_turn()
		expect(game.enemy_action(foe.id) and knight.hp == 9, "Knight Defense reduces incoming damage from " + kind)
		expect(game.last_event.contains("for 1."), "Combat log reports damage after Defense")
	game = arena()
	knight = game.add_unit("player", Vector2i(5, 5), "knight")
	foe = game.add_unit("enemy", Vector2i(6, 5), "raider")
	knight.hp = 7
	knight.defense = 3
	game.begin_enemy_turn()
	expect(game.enemy_action(foe.id) and knight.hp == 7 and foe.attacked, "Defense above Attack blocks damage without healing or preserving attack action")
	expect(game.last_event.contains("for 0."), "Fully blocked attack reports zero damage")
	for attack_first in [false, true]:
		game = arena()
		ally = game.add_unit("player", Vector2i(2, 2), "guard")
		foe = game.add_unit("enemy", Vector2i(3, 2), "raider")
		game.activate(ally.id)
		expect(not game.undo_move(), "Undo rejected before any move")
		if attack_first:
			game.attack_active(foe.id)
			expect(not game.can_undo_move() and not game.undo_move(), "Attack alone cannot be undone")
		game.move_active(Vector2i(3, 3))
		expect(game.active_id == ally.id and game.can_undo_move(), "Move leaves activation open and undo available in either order")
		expect(game.undo_move() and ally.cell == Vector2i(2, 2) and not ally.moved and ally.attacked == attack_first and foe.hp == (2 if attack_first else 5), "Undo restores origin and Move without reversing attack or damage")
		expect(not game.undo_move(), "Cannot undo the same move twice")
		game.move_active(Vector2i(3, 3))
		if attack_first:
			expect(not game.attack_active(foe.id), "Undo Move cannot restore an attack")
			game.finish_activation()
		else:
			game.attack_active(foe.id)
		expect(ally.finished and game.active_id == -1 and not game.undo_move(), "Finishing or attacking after moving closes undo window")
		game.begin_enemy_turn()
		game.begin_player_turn()
		game.activate(ally.id)
		expect(not game.can_undo_move() and ally.last_action == "", "New round cannot undo previous round’s movement")
	print("Battle suite: %d assertions, %d failures" % [checks, failures])
	quit(0 if failures == 0 else 1)
